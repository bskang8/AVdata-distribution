# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.venv/

# Environment variables (API keys, secrets)
.env
.env.*

# Data artifacts — large binary/generated files (not tracked in git)
# data/index/ — pipeline 빌드 출력 (대용량)
data/index/embeddings.npy
data/index/hnsw.index
data/index/bm25s_index/
data/index/bm25_index.pkl
data/index/umap_coords.parquet
data/index/distribution.html
data/index/longtail_clips.json
# data/tags/ — 추출 결과 (대용량)
data/tags/odd_tags.json
# data/artifacts/ — 실험별 스냅샷 (대용량 바이너리만 제외, 메타는 추적)
data/artifacts/*/embeddings.npy
data/artifacts/*/hnsw.index
data/artifacts/*/bm25s_index/
data/artifacts/*/odd_tags.json

# Experiment large binary outputs
experiments/*/results/*.npy

# Phase 0 output — 대용량 바이너리만 제외, 문서(md/json)는 추적
experiments/EXP-003/phase0/output/*.npy
experiments/EXP-003/phase0/output/*.npz
experiments/EXP-003/phase0/output/*.joblib

# Phase 1 output — per-clip 배열·창 캐시는 재생성 가능 → 제외, 문서(md/json)는 추적
experiments/EXP-003/phase1/output/*.npy
experiments/EXP-003/phase1/output/*.npz

# Phase 1 exposure — 대용량 raw 조달본만 제외(fetch로 재생성), 샘플·코드·json은 추적
experiments/EXP-003/phase1/exposure/raw/kma/asos_hourly.csv

# Runtime logs
logs/

# Literature — PDFs and all content not tracked in git
literature/

# IDE / OS
.vscode/
.idea/
.DS_Store

# EXP-003 phase2 (실 타깃) — 대용량/외부 아티팩트 제외 (코드·메타는 추적)
experiments/EXP-003/phase2/third_party/
experiments/EXP-003/phase2/**/output/*.pt
experiments/EXP-003/phase2/**/output/*.ckpt
experiments/EXP-003/phase2/**/*.parquet
# 로그·stdout 덤프·per-clip 캐시는 재생성 가능 → 제외 (baseline json·문서는 추적)
experiments/EXP-003/phase2/**/output/*.log
experiments/EXP-003/phase2/**/output/*.out
experiments/EXP-003/phase2/**/output/*.npz
experiments/EXP-003/phase2/**/output/*.npy

# phase2 SparseDrive 전용 venv (repo .venv와 별개)
experiments/EXP-003/phase2/.venv-sparsedrive/

data/index/longtail_clips.json
# data/tags/ — 추출 결과 (대용량)
data/tags/odd_tags.json
# data/artifacts/ — 실험별 스냅샷 (대용량 바이너리만 제외, 메타는 추적)
data/artifacts/*/embeddings.npy
data/artifacts/*/hnsw.index
data/artifacts/*/bm25s_index/
data/artifacts/*/odd_tags.json

# Experiment large binary outputs
experiments/*/results/*.npy

# Phase 0 output — 대용량 바이너리만 제외, 문서(md/json)는 추적
experiments/EXP-003/phase0/output/*.npy
experiments/EXP-003/phase0/output/*.npz
experiments/EXP-003/phase0/output/*.joblib

# Phase 1 exposure — 대용량 raw 조달본만 제외(fetch로 재생성), 샘플·코드·json은 추적
experiments/EXP-003/phase1/exposure/raw/kma/asos_hourly.csv

# Runtime logs
logs/

# Literature — PDFs and all content not tracked in git
literature/


+++ b/projects/configs/s1_leaveout_stage2.py
@@ -0,0 +1,71 @@
+# G-Q1 / S1 leave-out 학습 config — stage2-only(stage1 동결), 단일 GPU.
+# base = sparsedrive_small_stage2(전 recipe: optimizer/lr/pipeline/eval 상속).
+# 오버라이드: (1) stage1 동결 hook, (2) leave-out ann_file, (3) 1-GPU iters, (4) epochs.
+# 실행: LEAVEOUT/EPOCHS/WORKDIR 환경변수를 s1_run.sh가 주입(아래 os.environ).
+# ⚠️ stage1 동결 = "planning recoverability given fixed perception"(GQ1_S1_DESIGN §scope).
+#    load_from=stage1.pth의 param은 freeze, 새로(planning/ego) 초기화된 param만 학습.
+import os
+from mmcv.runner import HOOKS, Hook
+import torch
+
+_base_ = ["./sparsedrive_small_stage2.py"]
+
+
+@HOOKS.register_module(force=True)
+class _FreezeStage1Hook(Hook):
+    """stage1.pth에 있는 param은 requires_grad=False(동결), 나머지(planning head)만 학습."""
+    def __init__(self, stage1_ckpt):
+        self.stage1_ckpt = stage1_ckpt
+
+    def before_run(self, runner):
+        import torch                                # 메서드 로컬 import: config 모듈의 del torch와 무관
+        ckpt = torch.load(self.stage1_ckpt, map_location="cpu")
+        loaded = set(ckpt.get("state_dict", ckpt).keys())
+        model = runner.model.module if hasattr(runner.model, "module") else runner.model
+        n_f = n_t = 0
+        for name, p in model.named_parameters():
+            train_it = name not in loaded          # stage2-new(planning/ego)만 학습
+            p.requires_grad_(train_it)
+            n_t += int(train_it); n_f += int(not train_it)
+        runner.logger.info(f"[FreezeStage1] frozen={n_f} trainable(planning)={n_t}")
+        assert n_t > 0, "학습 가능 planning param 0 — stage1.pth 키 규칙 확인"
+    # ponytail: BN running-stat은 train모드로 갱신됨(동결 아님). arm 공통(baseline·leaveout 동일 recipe)
+    #  → ΔTail에서 common-mode로 상쇄. 정밀 필요시 before_train_epoch에서 frozen 모듈 .eval() 추가.
+
+
+del HOOKS, Hook, _FreezeStage1Hook   # cfg 오염 방지(등록됨). torch/os는 모듈이라 mmcv가 자동 제외 → del 금지(hook이 참조)
+
+# ---- 단일 GPU/leave-out 오버라이드 ----
+num_gpus = 1
+batch_size = int(os.environ.get("S1_BATCH", 4))            # 4090 24GB 안전값
+num_epochs = int(os.environ.get("S1_EPOCHS", 6))           # ⚠️ 비용/수렴 트레이드오프(설계 결정)
+length = 28130                                             # IterBasedRunner는 dataloader를 순환 → leave-out 감소분 무시 가능
+num_iters_per_epoch = int(length // (num_gpus * batch_size))
+
+_leaveout = os.environ.get("S1_LEAVEOUT", "")             # "" = full baseline arm(원본 train)
+data = dict(
+    samples_per_gpu=batch_size,
+    workers_per_gpu=batch_size,
+    train=dict(ann_file=_leaveout if _leaveout else "data/infos/nuscenes_infos_train.pkl"),
+)
+
+_max_iters = int(os.environ.get("S1_MAXITERS", num_iters_per_epoch * num_epochs))  # smoke용 오버라이드
+runner = dict(type="IterBasedRunner", max_iters=_max_iters)
+# 최신 1개만 유지(~410MB) → 중간 크래시 시 그 지점부터 재개(--resume-from) 가능.
+# 재부팅 크래시 대비 촘촘히 저장(기본 500iter≈4min). 손실 상한 = interval*iter_time. S1_CKPT_INTERVAL로 조정.
+_ckpt_interval = int(os.environ.get("S1_CKPT_INTERVAL", 500))
+# max_keep=3: base fp16 loss_scale=32.0(정적)이 motion 헤드 오버플로 시 nan 발산한 이력(iter19350) →
+# clean 롤백 지점 확보용. 아래 fp16 dynamic으로 근본 완화하지만 보험으로 유지.
+checkpoint_config = dict(interval=_ckpt_interval, max_keep_ckpts=3, by_epoch=False)
+# base(sparsedrive_small_stage2 L32)의 정적 loss_scale=32.0 → fp16 오버플로 스텝을 스킵/재스케일 못해
+# motion loss nan→파라미터 오염. dynamic으로 바꿔 오버플로 스텝 자동 스킵(mmcv Fp16OptimizerHook).
+fp16 = dict(loss_scale="dynamic")
+# 학습 중 eval 훅 비활성화: base(sparsedrive_small_stage2 L717)의 map-eval이 멀티프로세싱 데드락(futex hang).
+# interval을 max_iters 밖으로 밀어 절대 안 돌게 함. 평가는 학습 후 s1_run.sh 2)단계 test.py --out로 별도 수행.
+evaluation = dict(interval=_max_iters + 1)
+lr_config = dict(policy="CosineAnnealing", warmup="linear",
+                 warmup_iters=500, warmup_ratio=1.0 / 3, min_lr_ratio=1e-3)
+log_config = dict(interval=50, hooks=[dict(type="TextLoggerHook", by_epoch=False)])
+
+custom_hooks = [dict(type="_FreezeStage1Hook", stage1_ckpt="ckpt/sparsedrive_stage1.pth")]
+load_from = "ckpt/sparsedrive_stage1.pth"
